# =========================================================

# --- [1] KUBERNETES / INGRESS / DOCKERHUB PUSH ---
# USE THIS VALUE when building 'Dockerfile' to push to DockerHub.
# WHY: Nginx serves STATIC files. The URL is "baked" into the JS during 'npm run build'.
# An empty string ("") tells the browser to use the current Host/IP, which allows 
# the Ingress Controller to route '/books' requests to the backend internally.

# VITE_API_BACKEND_URL=""
# =========================================================

# =========================================================
# --- [2] FOR LOCAL DOCKER-COMPOSE / DEV ---
# ACTIVATE THIS only when running locally on your laptop.
# WHY: When running locally, the frontend and backend are on different ports.
# The browser needs the full 'localhost:8000' addresses to find the API.

VITE_API_BACKEND_URL="http://localhost:8000"
# =========================================================

# =========================================================
# ⚠️ CRITICAL NOTE:
# Since you are using the Nginx Dockerfile, K8s ConfigMaps 
# will NOT override these values at runtime. 
# You MUST ensure VITE_API_BACKEND_URL="" is active 
# BEFORE you run 'docker build' to push to DockerHub or GHCR.
# =========================================================